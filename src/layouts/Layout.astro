---
import '@/styles/global.css';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import SEO from '@/components/common/SEO.astro';
import SearchModal from '@/components/search/SearchModal.astro';

export interface Props {
  title?: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  type?: 'website' | 'article';
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
  jsonLd?: Record<string, any>;
}

const props = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <SEO {...props} />
  </head>
  <body class="min-h-screen flex flex-col bg-slate-50 text-slate-800 font-sans selection:bg-blue-100 selection:text-blue-900">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
    <SearchModal />
  </body>
</html>
