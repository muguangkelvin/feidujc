---
import type { CollectionEntry } from 'astro:content';
import Layout from './Layout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import TableOfContents from '@/components/blog/TableOfContents.astro';
import RelatedArticles from '@/components/blog/RelatedArticles.astro';
import { SITE } from '@/config/site';

export interface Props {
  post: CollectionEntry<'blog'>;
  headings: { depth: number; slug: string; text: string }[];
  allPosts: CollectionEntry<'blog'>[];
  prevPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

const { post, headings, allPosts, prevPost, nextPost } = Astro.props;

const { title, description, date, updated, category, tags, author } = post.data;

const formattedDate = date.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const formattedUpdatedDate = updated?.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const categoryLabels: Record<string, string> = {
  airports: '机场推荐',
  reviews: '机场实测',
  comparisons: '机场对比',
  guides: '新手教程',
  clients: '客户端教程',
  general: '综合资讯',
  faq: '常见问题',
};

const categoryLabel = categoryLabels[category] || category;

const breadcrumbs = [
  { name: categoryLabel, url: `/${category}/` },
  { name: title },
];

const postUrl = `${SITE.url}/${category}/${post.id}/`;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": title,
  "description": description,
  "datePublished": date.toISOString(),
  ...(updated ? { "dateModified": updated.toISOString() } : {}),
  "author": {
    "@type": "Organization",
    "name": author || SITE.author,
    "url": SITE.url
  },
  "publisher": {
    "@type": "Organization",
    "name": SITE.name,
    "url": SITE.url
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": postUrl
  }
};
---

<Layout
  title={title}
  description={description}
  canonicalUrl={postUrl}
  type="article"
  publishDate={date}
  updatedDate={updated}
  author={author}
  jsonLd={articleSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbs} />

    <!-- Main Article Layout grid -->
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <!-- Article Main Body -->
      <article class="lg:col-span-3 bg-white rounded-3xl border border-slate-200 p-6 sm:p-10 shadow-xs">
        <!-- Header metadata -->
        <header class="border-b border-slate-200 pb-8 mb-8">
          <div class="flex items-center gap-2 mb-4 flex-wrap">
            <a href={`/${category}/`} class="px-3 py-1 rounded-md bg-blue-50 text-blue-700 text-xs font-semibold hover:bg-blue-100 transition-colors">
              {categoryLabel}
            </a>
            <span class="text-slate-300">•</span>
            <time datetime={date.toISOString()} class="text-xs text-slate-500">
              发布日期：{formattedDate}
            </time>
            {formattedUpdatedDate && (
              <>
                <span class="text-slate-300">•</span>
                <span class="text-xs text-slate-500">更新于：{formattedUpdatedDate}</span>
              </>
            )}
          </div>

          <h1 class="text-2xl sm:text-4xl font-extrabold text-slate-900 leading-tight mb-4 tracking-tight">
            {title}
          </h1>

          <p class="text-sm sm:text-base text-slate-600 leading-relaxed bg-slate-50 p-4 rounded-2xl border border-slate-200/80">
            {description}
          </p>
        </header>

        <!-- Markdown Body -->
        <div class="prose-custom max-w-none">
          <slot />
        </div>

        <!-- Article Tags -->
        {tags && tags.length > 0 && (
          <div class="mt-10 pt-6 border-t border-slate-200 flex items-center gap-2 flex-wrap">
            <span class="text-xs font-semibold text-slate-500">文章标签：</span>
            {tags.map((tag) => (
              <a
                href={`/tags/${tag}/`}
                class="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-blue-50 hover:text-blue-600 text-xs text-slate-600 transition-colors"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}

        <!-- Prev / Next Article Pagination -->
        <nav class="mt-8 pt-8 border-t border-slate-200 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
          {prevPost ? (
            <a
              href={`/${prevPost.data.category}/${prevPost.id}/`}
              class="p-4 rounded-2xl border border-slate-200 hover:border-blue-200 hover:bg-blue-50/50 transition-all group"
            >
              <div class="text-slate-400 mb-1">← 上一篇</div>
              <div class="font-bold text-slate-800 group-hover:text-blue-600 line-clamp-1">{prevPost.data.title}</div>
            </a>
          ) : <div />}

          {nextPost ? (
            <a
              href={`/${nextPost.data.category}/${nextPost.id}/`}
              class="p-4 rounded-2xl border border-slate-200 hover:border-blue-200 hover:bg-blue-50/50 transition-all group text-right"
            >
              <div class="text-slate-400 mb-1">下一篇 →</div>
              <div class="font-bold text-slate-800 group-hover:text-blue-600 line-clamp-1">{nextPost.data.title}</div>
            </a>
          ) : <div />}
        </nav>

        <!-- Related Articles -->
        <RelatedArticles currentPost={post} allPosts={allPosts} />
      </article>

      <!-- Sidebar: Table of Contents -->
      <aside class="hidden lg:block lg:col-span-1">
        <TableOfContents headings={headings} />
      </aside>
    </div>
  </div>
</Layout>
