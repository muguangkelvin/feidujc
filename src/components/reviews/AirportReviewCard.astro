---
import type { Airport } from '@/data/airports';
import { getAirportReviewMeta } from '@/data/reviews';

interface Props { airport: Airport }
const { airport } = Astro.props;
const { title, description, readingMinutes } = getAirportReviewMeta(airport);
---

<a href={`/reviews/${airport.slug}/`} data-review-card data-search={[airport.name, airport.englishName, ...airport.aliases].filter(Boolean).join(' ').toLowerCase()} data-rank={airport.rank} data-month={airport.plans.some((plan) => plan.billingCycle === 'month') ? 'true' : 'false'} data-year={airport.plans.some((plan) => plan.billingCycle === 'year') ? 'true' : 'false'} class="group flex min-w-0 flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-xs transition-all hover:-translate-y-0.5 hover:border-blue-200 hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-500 focus-visible:ring-offset-2">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-2 text-xs">
    <span class="rounded-md bg-blue-50 px-2.5 py-1 font-semibold text-blue-700">机场测评</span>
    <time datetime={airport.lastVerified} class="text-slate-400">更新于 {airport.lastVerified}</time>
  </div>
  <h2 class="text-lg font-extrabold leading-snug text-slate-900 transition-colors group-hover:text-blue-600">{title}</h2>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{description}</p>
  <div class="mt-5 flex items-center justify-between border-t border-slate-100 pt-4 text-xs"><span class="text-slate-400">约 {readingMinutes} 分钟阅读</span><span class="font-semibold text-blue-600 transition-transform group-hover:translate-x-0.5">阅读全文 →</span></div>
</a>
