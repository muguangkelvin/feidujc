---
import { FEATURED_AIRPORTS, formatPrice, formatTraffic, getAiServices, getStreamingServices, getHomepageCapabilitySummary, getLowestEntryPlan, monthlyEquivalent, getRecommendationScore, type Airport } from '@/data/airports';

interface Props {
  airports?: Airport[];
  full?: boolean;
}

const { airports = FEATURED_AIRPORTS, full = false } = Astro.props;
const rankedAirports = [...airports].sort((a, b) => a.rank - b.rank);
---
<section id="airport-ranking" class="py-16 bg-white border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div><h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900">{full ? '完整机场排行榜' : '机场快速对比'}</h2><p class="text-sm text-slate-600 mt-2">{full ? `按统一机场数据展示全部 ${rankedAirports.length} 个机场；排名不代表实测评分。` : '固定 TOP 6 人工推荐顺序；排名不代表实测评分。'}</p></div>
      {!full && <a href="/ranking/" class="text-xs font-semibold text-blue-600">查看完整排行榜 →</a>}
    </div>
    <div class="hidden lg:block overflow-x-auto rounded-2xl border border-slate-200">
      <table class="w-full min-w-[1080px] text-left text-xs">
        <thead class="bg-slate-50 border-b border-slate-200"><tr>{['排名','机场','最低入门价','付款方式','对应流量','线路','AI','流媒体','综合推荐评分','详情'].map(h=><th class="px-4 py-4 font-semibold text-slate-800">{h}</th>)}</tr></thead>
        <tbody class="divide-y divide-slate-100">{rankedAirports.map(a=>{const p=getLowestEntryPlan(a);const rating=getRecommendationScore(a);return <tr>
          <td class="px-4 py-4 font-bold text-blue-600">#{a.rank}</td><td class="px-4 py-4 font-bold">{a.name}</td>
          <td class="px-4 py-4"><span class="font-bold">{formatPrice(p)}</span>{p?.billingCycle==='year'&&<small class="block text-slate-500">年付折算约 ¥{monthlyEquivalent(p).toFixed(2).replace(/\.00$/,'')}/月</small>}</td>
          <td class="px-4 py-4">{p&&(p.billingCycle==='year'?'年付':'月付')}</td><td class="px-4 py-4">{formatTraffic(p)}</td>
          <td class="px-4 py-4 whitespace-nowrap">{a.capabilities.line.display}</td><td class="px-4 py-4">{getAiServices(a).join(' / ')}</td><td class="px-4 py-4">{getStreamingServices(a).join(' / ')}</td>
          <td class="px-4 py-4 font-bold text-blue-700">{rating!==null&&`${rating.toFixed(1)} / 10`}</td><td class="px-4 py-4"><a href={`/airports/${a.slug}/`} class="text-blue-600 font-semibold">详情</a></td>
        </tr>})}</tbody>
      </table>
    </div>
    <div class="lg:hidden space-y-3">{rankedAirports.map(a=>{const p=getLowestEntryPlan(a);const rating=getRecommendationScore(a);return <article class="rounded-xl border border-slate-200 p-4">
      <div class="flex justify-between gap-3"><div><span class="text-xs font-bold text-blue-600">TOP {a.rank}</span><h3 class="font-bold text-slate-900">{a.name}</h3></div>{rating!==null&&<span class="text-xs font-bold text-blue-700">{rating.toFixed(1)} / 10</span>}</div>
      <div class="grid grid-cols-2 gap-2 text-xs mt-3"><div><span class="text-slate-400">价格：</span>{formatPrice(p)}</div><div><span class="text-slate-400">流量：</span>{formatTraffic(p)}</div><div class="col-span-2 min-w-0"><span class="text-slate-400">线路：</span><span class="break-words">{a.capabilities.line.display}</span></div><div class="col-span-2 min-w-0"><span class="text-slate-400">AI/流媒体：</span><span class="break-words">{getHomepageCapabilitySummary(a)}</span></div></div>
      <a href={`/airports/${a.slug}/`} class="block text-center mt-3 py-2 rounded-lg bg-blue-50 text-blue-700 text-xs font-semibold">查看详情</a>
    </article>})}</div>
  </div>
</section>
