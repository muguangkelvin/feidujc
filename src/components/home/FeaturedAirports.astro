---
import { FEATURED_AIRPORTS, formatPrice, formatTraffic, getAiServices, getRecommendationScore, getStreamingServices, type Airport } from '@/data/airports';

interface EditorialCopy { overview: string; audience: string; advice: string; }

const editorialCopy = (airport: Airport): EditorialCopy => {
  const [entry, middle, upper] = airport.plans;
  const priceTraffic = (plan: typeof entry) => plan ? `${formatPrice(plan)}、${formatTraffic(plan)}` : '';

  switch (airport.id) {
    case 'lingdong': return {
      overview: `灵动云的三档月付方案从 ${priceTraffic(entry)} 起步，中档提升到 ${priceTraffic(middle)}，高档则提供 ${priceTraffic(upper)}。流量梯度清楚，用户可以按当前用量逐级选择，不必为了预留空间直接跳到最高档。当前线路、AI 与流媒体信息来自公开资料，实际表现仍应在自己的网络环境中验证。`,
      audience: '适合希望从明确的入门、中等和大流量层级中做选择，同时需要比较 AI 与常用流媒体支持的用户。',
      advice: '轻度使用可先观察入门档是否足够；日常视频和多项在线服务可比较中档；只有持续高流量或多设备共享时，再考虑最高档。',
    };
    case 'twilight': return {
      overview: `暮光网络的入门档为 ${priceTraffic(entry)}，中档为 ${priceTraffic(middle)}，两者适合预算和用量相对明确的人逐步比较；${priceTraffic(upper)} 的高档与前两档拉开明显容量差距。公开资料标注了专线与 BGP 优化，但线路名称并不等于速度结论，购买前仍要结合常用地区和高峰时段观察。`,
      audience: '适合流量需求从日常浏览逐渐增加到较高用量，并希望在相邻月付档位之间保留升级空间的用户。',
      advice: '先按真实月用量比较前两档；如果长期接近上限，再评估高档。AI 和流媒体可用性仍可能随节点及平台策略变化。',
    };
    case 'invisible': return {
      overview: `隐形人的三档套餐分别覆盖 ${formatTraffic(entry)}、${formatTraffic(middle)} 和 ${formatTraffic(upper)}，容量跨度适合把普通使用、中高频使用与多设备大流量需求分开考虑。三档均为月付，便于根据使用记录调整。公开线路标注为 VLESS 专线，但名称本身不能证明晚高峰速度或稳定性，实际体验可能受到用户所在地、本地网络、使用时段及节点负载影响。`,
      audience: '适合希望入门流量比轻量套餐更宽裕，或需要为视频、多设备和较频繁在线任务预留容量的用户。',
      advice: '普通使用先比较第一档；持续视频或较高频任务可看中档；多设备和大流量需求再考虑高档，并先验证常用节点。',
    };
    case 'laddercloud': return {
      overview: `梯子云以 ${priceTraffic(entry)} 作为入门选择，中档提升至 ${priceTraffic(middle)}，高档达到 ${priceTraffic(upper)}。这种结构适合先用基础档记录真实消耗，再决定是否扩大流量。公开资料中的 IEPL 与 VLESS 可作为线路筛选线索，但不能替代本地网络、节点负载和使用时段下的实际验证。`,
      audience: '适合月流量需求处于基础到中高范围，并同时关注 ChatGPT、Claude 与常见视频平台公开支持信息的用户。',
      advice: '不确定用量时从入门档开始；经常观看高清视频或下载文件时比较中档；高档更适合长期接近较大流量的人。',
    };
    case 'wavenet': return {
      overview: `浪网的套餐结构与其他前六名不同：前两档是 ${priceTraffic(entry)} 和 ${priceTraffic(middle)} 的高流量月付方案，第三档则是 ${formatPrice(upper)}、${formatTraffic(upper)} 的轻量年付方案。年付价格代表一次支付全年费用，不能写成月付。两类方案面向的使用强度差异很大，应先确定自己需要低年度总支出还是高月度容量。`,
      audience: '年付档适合用量较轻且接受长期付款的人；两档月付则更适合持续大流量、高清视频或多设备共享需求。',
      advice: '不要只按价格从低到高比较。先区分年付和月付，再核对月流量；首次使用长期方案前，仍应确认常用节点及所需平台。',
    };
    case 'flyv': return {
      overview: `飞V从 ${priceTraffic(entry)} 的基础档起步，中档提供 ${priceTraffic(middle)}，高档为 ${priceTraffic(upper)}，三档都是月付。流量增幅适合按照使用强度逐步判断：基础档覆盖常规需求，中档为更频繁的视频与在线任务留出空间，高档则面向持续大流量。当前专线、AI 和流媒体信息属于公开参考，并非速度或稳定性实测。`,
      audience: '适合希望以月付方式在基础、中等和较大流量之间切换，并关注常见 AI 与流媒体服务的用户。',
      advice: '先用当前设备统计估算流量，再选择最接近的一档；若连续数月接近上限再升级，不必单纯因为容量更大直接选择高档。',
    };
    default: return { overview: airport.description, audience: '适合根据预算、流量和主要使用场景进一步比较的用户。', advice: '建议先核对套餐周期和公开资料，再从风险可控的付款周期开始验证。' };
  }
};

const hasFeiduTest = (airport: Airport) => airport.capabilities.evidenceLevel === 'feidu_test';
---

<section id="recommended" class="scroll-mt-16 border-b border-slate-200/60 bg-white py-16">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <header class="border-b border-slate-200 pb-8">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <h2 class="text-2xl font-extrabold text-slate-900 sm:text-3xl">2026 热门机场推荐</h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">从价格、流量和公开参考能力快速比较，实际可用性以使用结果为准。</p>
        </div>
        <a href="/airports/" class="shrink-0 text-sm font-semibold text-blue-600 hover:text-blue-700">查看全部机场 →</a>
      </div>
    </header>

    <div class="mt-8 space-y-6 sm:space-y-8">
      {FEATURED_AIRPORTS.map((airport) => {
        const copy = editorialCopy(airport);
        const ai = getAiServices(airport);
        const streaming = getStreamingServices(airport);
        const rating = getRecommendationScore(airport);
        const showEnglishName = airport.englishName && airport.englishName.toLowerCase() !== airport.name.toLowerCase();

        return (
          <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-[0_1px_2px_rgba(15,23,42,0.03)] transition-[transform,border-color,box-shadow] duration-200 ease-out sm:p-8 lg:p-10 md:hover:-translate-y-0.5 md:hover:border-blue-200 md:hover:shadow-[0_8px_24px_rgba(15,23,42,0.06)]">
            <p class="inline-flex rounded-md bg-blue-50 px-2.5 py-1 text-xs font-extrabold tracking-wide text-blue-600">TOP {airport.rank}</p>
            <h2 class="mt-3 break-words text-2xl font-extrabold text-slate-900 sm:text-3xl">
              {airport.name}
              {showEnglishName && <span class="ml-2 text-lg font-semibold text-slate-500 sm:text-xl">{airport.englishName}</span>}
            </h2>
            <p class="mt-5 text-[15px] leading-8 text-slate-700 sm:text-base">{copy.overview}</p>

            <section class="mt-8" aria-labelledby={`${airport.id}-plans`}>
              <h3 id={`${airport.id}-plans`} class="text-lg font-bold text-slate-900">套餐与价格</h3>
              <div class="mt-3 hidden sm:block">
                <table class="w-full border-collapse text-left text-sm">
                  <thead class="border-y border-slate-200 text-slate-500"><tr><th class="py-3 pr-4 font-semibold">套餐</th><th class="px-4 py-3 font-semibold">价格</th><th class="px-4 py-3 font-semibold">流量</th><th class="py-3 pl-4 font-semibold">付款周期</th></tr></thead>
                  <tbody class="divide-y divide-slate-100">{airport.plans.map((plan) => <tr><td class="py-3 pr-4 font-medium text-slate-800">{plan.name}</td><td class="px-4 py-3 font-semibold text-blue-700">{formatPrice(plan)}</td><td class="px-4 py-3">{formatTraffic(plan)}</td><td class="py-3 pl-4">{plan.billingCycle === 'year' ? '年付' : '月付'}</td></tr>)}</tbody>
                </table>
              </div>
              <div class="mt-3 divide-y divide-slate-100 border-y border-slate-200 sm:hidden">
                {airport.plans.map((plan) => <div class="py-4"><strong class="block text-sm text-slate-900">{plan.name}</strong><p class="mt-1 text-sm"><span class="font-semibold text-blue-700">{formatPrice(plan)}</span><span class="mx-2 text-slate-300">·</span>{formatTraffic(plan)}<span class="mx-2 text-slate-300">·</span>{plan.billingCycle === 'year' ? '年付' : '月付'}</p></div>)}
              </div>
            </section>

            <section class="mt-8" aria-labelledby={`${airport.id}-capabilities`}>
              <h3 id={`${airport.id}-capabilities`} class="text-lg font-bold text-slate-900">线路与功能</h3>
              <dl class="mt-3 space-y-2 text-[15px] leading-7 text-slate-700">
                <div><dt class="inline font-semibold text-slate-900">线路：</dt><dd class="inline">{airport.capabilities.line.display}</dd></div>
                {ai.length > 0 && <div><dt class="inline font-semibold text-slate-900">AI 支持：</dt><dd class="inline">{ai.join(' / ')}</dd></div>}
                {streaming.length > 0 && <div><dt class="inline font-semibold text-slate-900">流媒体：</dt><dd class="inline">{streaming.join(' / ')}</dd></div>}
                {rating !== null && <div><dt class="inline font-semibold text-slate-900">综合推荐评分：</dt><dd class="inline">{rating.toFixed(1)} / 10</dd></div>}
                <div><dt class="inline font-semibold text-slate-900">资料状态：</dt><dd class="inline text-slate-600">{hasFeiduTest(airport) ? '飞渡实测' : '公开资料整理'}</dd></div>
                <div><dt class="inline font-semibold text-slate-900">{hasFeiduTest(airport) ? '实测日期：' : '资料更新：'}</dt><dd class="inline text-slate-600">{airport.lastVerified}</dd></div>
              </dl>
            </section>

            <section class="mt-8" aria-labelledby={`${airport.id}-audience`}><h3 id={`${airport.id}-audience`} class="text-lg font-bold text-slate-900">适合人群</h3><p class="mt-3 text-[15px] leading-8 text-slate-700">{copy.audience}</p></section>
            <section class="mt-8" aria-labelledby={`${airport.id}-advice`}><h3 id={`${airport.id}-advice`} class="text-lg font-bold text-slate-900">选择建议</h3><p class="mt-3 text-[15px] leading-8 text-slate-700">{copy.advice}</p></section>

            <nav class="mt-7 flex flex-wrap gap-x-6 gap-y-3 text-sm font-semibold" aria-label={`${airport.name}相关链接`}>
              <a href={`/reviews/${airport.slug}/`} class="text-blue-600 hover:text-blue-800">查看详细测评 →</a>
              <a href={airport.officialUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" class="text-blue-600 hover:text-blue-800">访问官网 ↗</a>
            </nav>
          </article>
        );
      })}
    </div>
  </div>
</section>
