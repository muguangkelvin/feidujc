---
const clientPlatforms = [
  {
    name: "Windows 客户端",
    os: "Windows",
    desc: "支持 Clash Verge Rev, Sing-Box, V2rayN 等全功能加速软件",
    href: "/clients/windows/",
    popularTool: "Clash Verge Rev",
    badge: "微软 PC"
  },
  {
    name: "macOS 客户端",
    os: "macOS",
    desc: "支持 Clash Verge Rev, Surge, ClashX Pro 等高效配置工具",
    href: "/clients/macos/",
    popularTool: "Clash Verge / Surge",
    badge: "苹果 Mac"
  },
  {
    name: "Android 客户端",
    os: "Android",
    desc: "支持 Clash Meta for Android, Surfboard, NekoBox 等安卓软件",
    href: "/clients/android/",
    popularTool: "Clash Meta / Surfboard",
    badge: "安卓手机"
  },
  {
    name: "iOS 客户端",
    os: "iOS / iPadOS",
    desc: "支持 Shadowrocket (小火箭), Quantumult X, Stash, Loon",
    href: "/clients/ios/",
    popularTool: "Shadowrocket / Stash",
    badge: "iPhone / iPad"
  }
];
---

<section id="clients-section" class="py-16 bg-slate-50 border-b border-slate-200/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
      <div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
          客户端使用教程
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          涵盖全平台主流加速软件的安装、配置与一键导入教程
        </p>
      </div>
      <a href="/clients/" class="inline-flex items-center text-xs font-semibold text-blue-600 hover:text-blue-700">
        查看全部客户端列表 →
      </a>
    </div>

    <!-- Client Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {
        clientPlatforms.map((client) => (
          <a
            href={client.href}
            class="bg-white rounded-2xl border border-slate-200 p-6 shadow-xs hover:shadow-md hover:border-slate-300 transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold">
                  {client.badge}
                </span>
                <span class="text-xs text-blue-600 font-medium group-hover:translate-x-0.5 transition-transform">
                  教程 →
                </span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-blue-600 transition-colors mb-2">
                {client.name}
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed mb-4">
                {client.desc}
              </p>
            </div>

            <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-400">
              <span>主力推荐</span>
              <span class="font-medium text-slate-700">{client.popularTool}</span>
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>
