---
import type { Airport, RecommendationScores } from '@/data/airports';
import { getRecommendationScore } from '@/data/airports';
interface Props { airport: Airport; detailed?: boolean }
const {airport,detailed=true}=Astro.props;
const total=getRecommendationScore(airport);
const labels:Record<keyof RecommendationScores,string>={experience:'综合体验',stability:'线路稳定性',speed:'网络速度',ai:'AI 适配',streaming:'流媒体',value:'套餐性价比',traffic:'流量充足度',recommendation:'综合推荐度'};
const scoreRows=airport.recommendationScores
  ? (Object.entries(labels) as Array<[keyof RecommendationScores,string]>).map(([key,label])=>({key,label,value:airport.recommendationScores![key]}))
  : [];
---
{total !== null && <section class="rounded-2xl border border-blue-100 bg-gradient-to-br from-blue-50 to-white p-5 sm:p-6" aria-label="综合推荐评分">
  <div class="flex flex-wrap items-end justify-between gap-3"><div><p class="text-xs font-bold text-blue-700">综合推荐评分</p><p class="mt-1 text-3xl font-extrabold text-slate-900">{total.toFixed(1)} <span class="text-base text-slate-400">/ 10</span></p></div><div class="text-amber-500 text-lg tracking-wider" aria-label="推荐指数五星">★★★★★</div></div>
  <p class="mt-3 text-xs leading-relaxed text-slate-600">综合推荐评分基于套餐、流量、产品定位及综合使用价值评估，实际网络表现请以实测结果为准。</p>
  {detailed&&scoreRows.length>0&&<div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">{scoreRows.map(({key,label,value})=><div data-score-key={key}><div class="flex justify-between text-xs"><span class="text-slate-600">{label}</span><strong>{value.toFixed(1)}</strong></div><div class="mt-1 h-1.5 rounded-full bg-slate-200 overflow-hidden"><div class="h-full rounded-full bg-blue-600" style={`width:${value*10}%`}></div></div></div>)}</div>}
</section>}
