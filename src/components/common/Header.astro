---
import { NAV_LINKS, SITE } from '@/config/site';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="/" class="flex items-center gap-2 group">
      <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-blue-600 to-indigo-600 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:shadow transition-shadow">
        飞
      </div>
      <div>
        <span class="text-lg font-bold text-slate-900 leading-tight group-hover:text-blue-600 transition-colors">
          {SITE.name}
        </span>
      </div>
    </a>

    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex items-center gap-1">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${
                isActive
                  ? 'text-blue-600 bg-blue-50/80 font-semibold'
                  : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100/60'
              }`}
            >
              {link.name}
            </a>
          );
        })
      }
      <a
        href="/profile/"
        class={`flex items-center gap-1.5 px-3.5 py-2 rounded-lg text-sm font-medium transition-colors ${
          currentPath.startsWith('/profile/')
            ? 'text-blue-600 bg-blue-50/80 font-semibold'
            : 'text-slate-600 hover:text-blue-600 hover:bg-blue-50/70'
        }`}
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 21a8 8 0 0 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
        </svg>
        <span>个人中心</span>
      </a>
      <a
        href="https://t.me/+rthlhpWiKOtlZjJl"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="加入飞渡机场 Telegram"
        title="加入 Telegram"
        class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-500 transition-colors hover:bg-blue-50 hover:text-blue-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
      >
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M21.7 3.2a1.2 1.2 0 0 0-1.25-.2L3.1 9.75a1.2 1.2 0 0 0 .08 2.27l4.38 1.46 1.65 5.16a1.2 1.2 0 0 0 2.08.4l2.4-2.93 4.7 3.45a1.2 1.2 0 0 0 1.88-.74l2.12-14.5a1.2 1.2 0 0 0-.69-1.12ZM9.42 12.84l8.36-5.27-6.8 6.51-.53 2.52-1.03-3.76Z" />
        </svg>
      </a>
    </nav>

    <!-- Right Search Trigger & Mobile Menu Toggle -->
    <div class="flex items-center gap-2">
      <button
        id="search-trigger"
        type="button"
        class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-slate-200 text-xs font-medium text-slate-500 bg-slate-50 hover:bg-slate-100 hover:text-slate-800 transition-colors cursor-pointer"
        aria-label="搜索站内内容"
      >
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <span class="hidden sm:inline">搜索...</span>
        <kbd class="hidden sm:inline-block px-1.5 py-0.5 text-[10px] font-mono bg-white border border-slate-200 rounded text-slate-400">Ctrl K</kbd>
      </button>

      <!-- Mobile Menu Toggle Button -->
      <button
        id="mobile-menu-toggle"
        type="button"
        class="lg:hidden p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors"
        aria-label="切换菜单"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon-open" class="inline" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 pt-3 pb-5 space-y-1 shadow-lg">
    {
      NAV_LINKS.map((link) => {
        const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`block px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
              isActive
                ? 'text-blue-600 bg-blue-50 font-semibold'
                : 'text-slate-700 hover:bg-slate-100 hover:text-slate-900'
            }`}
          >
            {link.name}
          </a>
        );
      })
    }
    <a
      href="/profile/"
      class={`flex items-center gap-2 px-3 py-2.5 rounded-lg text-base font-medium transition-colors ${
        currentPath.startsWith('/profile/')
          ? 'text-blue-600 bg-blue-50 font-semibold'
          : 'text-slate-700 hover:bg-blue-50 hover:text-blue-600'
      }`}
    >
      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M20 21a8 8 0 0 0-16 0M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8Z" />
      </svg>
      <span>个人中心</span>
    </a>
    <a
      href="https://t.me/+rthlhpWiKOtlZjJl"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="加入飞渡机场 Telegram"
      title="加入 Telegram"
      class="flex items-center gap-2 px-3 py-2.5 rounded-lg text-base font-medium text-slate-700 transition-colors hover:bg-blue-50 hover:text-blue-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600"
    >
      <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M21.7 3.2a1.2 1.2 0 0 0-1.25-.2L3.1 9.75a1.2 1.2 0 0 0 .08 2.27l4.38 1.46 1.65 5.16a1.2 1.2 0 0 0 2.08.4l2.4-2.93 4.7 3.45a1.2 1.2 0 0 0 1.88-.74l2.12-14.5a1.2 1.2 0 0 0-.69-1.12ZM9.42 12.84l8.36-5.27-6.8 6.51-.53 2.52-1.03-3.76Z" />
      </svg>
      <span>Telegram 社群 ↗</span>
    </a>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  toggleBtn?.addEventListener('click', () => {
    const isHidden = menu?.classList.contains('hidden');
    if (isHidden) {
      menu?.classList.remove('hidden');
      openIcon?.classList.add('hidden');
      openIcon?.classList.remove('inline');
      closeIcon?.classList.remove('hidden');
      closeIcon?.classList.add('inline');
    } else {
      menu?.classList.add('hidden');
      openIcon?.classList.remove('hidden');
      openIcon?.classList.add('inline');
      closeIcon?.classList.add('hidden');
      closeIcon?.classList.remove('inline');
    }
  });
</script>
