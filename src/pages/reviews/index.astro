---
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import AirportReviewCard from '@/components/reviews/AirportReviewCard.astro';
import { AIRPORTS } from '@/data/airports';
import { REVIEW_ENTRIES } from '@/data/reviews';

const reviews = REVIEW_ENTRIES(AIRPORTS);
const breadcrumbs = [{ name: '机场测评' }];
---

<Layout title="机场测评与推荐分析 - 飞渡机场" description={`飞渡机场整理全部 ${reviews.length} 个已收录机场的套餐、线路、AI 与流媒体资料；公开参考与本站实测信息分开标注。`} canonicalUrl="https://feidujc.com/reviews/">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={breadcrumbs} />
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">机场测评与推荐分析</h1>
      <p class="text-slate-600 text-sm sm:text-base max-w-3xl leading-relaxed">共收录 {reviews.length} 个机场。页面依据已知套餐与公开资料整理，推荐排名不等同于实测结果，未核实项目会明确标注。</p>
    </header>

    <section aria-label="测评搜索与筛选" class="rounded-2xl border border-slate-200 bg-white p-4 sm:p-5 mb-8">
      <label for="review-search" class="sr-only">搜索机场名称</label>
      <input id="review-search" type="search" placeholder="搜索机场名称..." class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
      <div class="mt-4 flex flex-wrap gap-2" role="group" aria-label="筛选测评">
        <button type="button" data-review-filter="all" aria-pressed="true" class="review-filter rounded-full bg-blue-600 px-4 py-2 text-xs font-semibold text-white">全部测评</button>
        <button type="button" data-review-filter="top10" aria-pressed="false" class="review-filter rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200">TOP 10</button>
        <button type="button" data-review-filter="month" aria-pressed="false" class="review-filter rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200">月付套餐</button>
        <button type="button" data-review-filter="year" aria-pressed="false" class="review-filter rounded-full bg-slate-100 px-4 py-2 text-xs font-semibold text-slate-700 hover:bg-slate-200">年付套餐</button>
      </div>
      <p id="review-count" class="mt-3 text-xs text-slate-500" aria-live="polite">显示全部 {reviews.length} 篇测评</p>
    </section>

    <div id="review-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {reviews.map(({ airport }) => <AirportReviewCard airport={airport} />)}
    </div>
    <div id="review-empty" hidden class="rounded-2xl border border-slate-200 bg-white p-12 text-center text-slate-500">没有找到符合条件的机场测评。</div>
  </div>
</Layout>

<script>
  const search = document.querySelector<HTMLInputElement>('#review-search');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-review-card]'));
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-review-filter]'));
  const count = document.querySelector<HTMLElement>('#review-count');
  const grid = document.querySelector<HTMLElement>('#review-grid');
  const empty = document.querySelector<HTMLElement>('#review-empty');
  let activeFilter = 'all';
  const update = () => {
    const query = search?.value.trim().toLowerCase() ?? '';
    let visible = 0;
    cards.forEach((card) => {
      const matchesSearch = (card.dataset.search ?? '').includes(query);
      const matchesFilter = activeFilter === 'all' || (activeFilter === 'top10' && Number(card.dataset.rank) <= 10) || (activeFilter === 'month' && card.dataset.month === 'true') || (activeFilter === 'year' && card.dataset.year === 'true');
      card.hidden = !(matchesSearch && matchesFilter);
      if (!card.hidden) visible += 1;
    });
    if (count) count.textContent = `显示 ${visible} 篇测评`;
    if (grid) grid.hidden = visible === 0;
    if (empty) empty.hidden = visible !== 0;
  };
  search?.addEventListener('input', update);
  buttons.forEach((button) => button.addEventListener('click', () => {
    activeFilter = button.dataset.reviewFilter ?? 'all';
    buttons.forEach((item) => {
      const active = item === button;
      item.setAttribute('aria-pressed', String(active));
      item.classList.toggle('bg-blue-600', active); item.classList.toggle('text-white', active);
      item.classList.toggle('bg-slate-100', !active); item.classList.toggle('text-slate-700', !active);
    });
    update();
  }));
</script>
