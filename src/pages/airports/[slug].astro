---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import ArticleCard from '@/components/blog/ArticleCard.astro';
import RecommendationScore from '@/components/airports/RecommendationScore.astro';
import { AIRPORTS, formatPrice, formatTraffic, getAiServices, getStreamingServices, monthlyEquivalent, type Airport } from '@/data/airports';
import { SITE } from '@/config/site';

export function getStaticPaths(){return AIRPORTS.map(airport=>({params:{slug:airport.slug},props:{airport}}));}
interface Props { airport: Airport }
const {airport}=Astro.props;
const posts=await getCollection('blog',p=>!p.data.draft);
const terms=[airport.name,airport.englishName,...airport.aliases].filter(Boolean) as string[];
const related=posts.filter(p=>terms.some(term=>p.data.title.includes(term)||p.data.description.includes(term)||p.data.tags.some(t=>t.includes(term)))).slice(0,3);
const displayName=airport.englishName&&!airport.name.toLowerCase().includes(airport.englishName.toLowerCase())?`${airport.name}（${airport.englishName}）`:airport.name;
const aiServices=getAiServices(airport);
const streamingServices=getStreamingServices(airport);
const hasPlanSpecs=airport.plans.some(plan=>plan.line||plan.devices||plan.speed);
const planFeatures=airport.plans.filter(plan=>plan.feature);
const testRows=[
  {label:'线路实测',value:airport.testResults.line},
  {label:'延迟',value:airport.testResults.latencyMs===null?null:`${airport.testResults.latencyMs} ms`},
  {label:'下载速度',value:airport.testResults.downloadMbps===null?null:`${airport.testResults.downloadMbps} Mbps`},
  {label:'上传速度',value:airport.testResults.uploadMbps===null?null:`${airport.testResults.uploadMbps} Mbps`},
  {label:'丢包率',value:airport.testResults.packetLossPercent===null?null:`${airport.testResults.packetLossPercent}%`},
  {label:'AI 实测',value:airport.testResults.ai},
  {label:'Netflix',value:airport.testResults.netflix},
  {label:'Disney+',value:airport.testResults.disneyPlus},
  {label:'Spotify',value:airport.testResults.spotify},
].filter((item): item is {label:string;value:string}=>item.value!==null);
const schema={"@context":"https://schema.org","@type":"WebPage","name":`${airport.name}套餐价格与使用信息`,"url":`${SITE.url}/airports/${airport.slug}/`,"description":airport.description,"dateModified":airport.lastVerified};
---
<Layout title={`${airport.name}怎么样？套餐价格与使用信息`} description={`${displayName}套餐价格、月流量、公开参考线路及平台支持信息汇总；真实网络表现与可用性以实际测试为准。`} canonicalUrl={`${SITE.url}/airports/${airport.slug}/`} jsonLd={schema}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
    <Breadcrumbs items={[{name:'机场推荐',url:'/airports/'},{name:airport.name}]} />
    <header class="rounded-3xl border border-slate-200 bg-white p-6 sm:p-10 mb-8"><div class="grid grid-cols-1 lg:grid-cols-[1fr_420px] gap-8"><div><span class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">推荐排名 #{airport.rank}</span><h1 class="mt-4 text-3xl sm:text-4xl font-extrabold text-slate-900">{displayName}</h1><p class="mt-3 max-w-2xl text-sm sm:text-base text-slate-600 leading-relaxed">{airport.description}</p><div class="mt-6 flex flex-col sm:flex-row gap-3"><a href={`/reviews/${airport.slug}/`} class="inline-flex justify-center rounded-xl border border-blue-200 bg-blue-50 px-6 py-3 text-sm font-semibold text-blue-700 hover:bg-blue-100">查看完整测评 →</a><a href={airport.officialUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" class="official-link inline-flex justify-center rounded-xl px-6 py-3 text-sm font-semibold transition-colors">访问官网</a></div></div><RecommendationScore airport={airport}/></div><p class="mt-6 text-xs text-slate-500">部分外部链接可能包含推广参数；本站可能获得推广收益，但不会增加你的购买价格。</p></header>
    <section aria-labelledby="plans-heading" class="mb-8"><h2 id="plans-heading" class="text-2xl font-extrabold text-slate-900 mb-5">套餐价格</h2>{airport.plans.length>0&&<><div class="hidden md:block overflow-x-auto rounded-2xl border border-slate-200 bg-white"><table class={`w-full text-sm ${hasPlanSpecs?'min-w-[980px]':'min-w-[760px]'}`}><thead class="bg-slate-50"><tr><th class="px-5 py-4 text-left">套餐</th><th class="px-5 py-4 text-left">价格</th><th class="px-5 py-4 text-left">付款周期</th><th class="px-5 py-4 text-left">每月流量</th>{hasPlanSpecs&&<><th class="px-5 py-4 text-left">线路</th><th class="px-5 py-4 text-left">设备</th><th class="px-5 py-4 text-left">速度</th></>}<th class="px-5 py-4 text-left">折算月均价格</th><th class="px-5 py-4 text-left">操作</th></tr></thead><tbody class="divide-y divide-slate-100">{airport.plans.map(p=><tr><td class="px-5 py-4 font-bold">{p.name}</td><td class="px-5 py-4 font-bold text-blue-700">{formatPrice(p)}</td><td class="px-5 py-4">{p.billingCycle==='year'?'年付':'月付'}</td><td class="px-5 py-4">{formatTraffic(p)}</td>{hasPlanSpecs&&<><td class="px-5 py-4 whitespace-nowrap">{p.line??'—'}</td><td class="px-5 py-4 whitespace-nowrap">{p.devices??'—'}</td><td class="px-5 py-4 whitespace-nowrap">{p.speed??'—'}</td></>}<td class="px-5 py-4">{p.billingCycle==='year'?`约 ¥${monthlyEquivalent(p).toFixed(2).replace(/\.00$/,'')}/月（年付折算）`:'—'}</td><td class="px-5 py-4"><a href={airport.officialUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" class="text-blue-600 font-semibold">访问官网</a></td></tr>)}</tbody></table></div><div class="md:hidden space-y-3">{airport.plans.map(p=><article class="rounded-xl border border-slate-200 bg-white p-4"><div class="flex justify-between gap-3"><h3 class="font-bold">{p.name}</h3><strong class="text-blue-700 whitespace-nowrap">{formatPrice(p)}</strong></div><dl class="mt-3 grid grid-cols-2 gap-2 text-xs"><div><dt class="text-slate-400">付款周期</dt><dd>{p.billingCycle==='year'?'年付':'月付'}</dd></div><div><dt class="text-slate-400">每月流量</dt><dd>{formatTraffic(p)}</dd></div>{p.line&&<div><dt class="text-slate-400">线路</dt><dd>{p.line}</dd></div>}{p.devices&&<div><dt class="text-slate-400">设备</dt><dd>{p.devices}</dd></div>}{p.speed&&<div><dt class="text-slate-400">速度</dt><dd>{p.speed}</dd></div>}{p.billingCycle==='year'&&<div><dt class="text-slate-400">年付折算</dt><dd>约 ¥{monthlyEquivalent(p).toFixed(2).replace(/\.00$/,'')}/月</dd></div>}</dl><a href={airport.officialUrl} target="_blank" rel="sponsored nofollow noopener noreferrer" class="block mt-3 rounded-lg bg-blue-50 py-2 text-center text-xs font-semibold text-blue-700">访问官网</a></article>)}</div></>}</section>
    {planFeatures.length>0&&<section class="mb-8" aria-labelledby="plan-features-heading"><h2 id="plan-features-heading" class="text-2xl font-extrabold text-slate-900 mb-5">套餐特点</h2><div class="grid grid-cols-1 md:grid-cols-2 gap-4">{planFeatures.map(plan=><article class="rounded-2xl border border-slate-200 bg-white p-5"><h3 class="font-bold text-slate-900">{plan.name}</h3><p class="mt-2 text-sm leading-relaxed text-slate-600">{plan.feature}</p>{(plan.routing||plan.multiplier||plan.peakBandwidth||plan.regions||plan.reset)&&<dl class="mt-4 space-y-2 border-t border-slate-100 pt-3 text-xs">{plan.routing&&<div><dt class="text-slate-400">线路说明</dt><dd class="mt-1 text-slate-700">{plan.routing}</dd></div>}{plan.multiplier&&<div><dt class="text-slate-400">流量倍率</dt><dd class="mt-1 text-slate-700">{plan.multiplier}</dd></div>}{plan.peakBandwidth&&<div><dt class="text-slate-400">单节点峰值</dt><dd class="mt-1 text-slate-700">{plan.peakBandwidth}</dd></div>}{plan.regions&&<div><dt class="text-slate-400">节点覆盖</dt><dd class="mt-1 text-slate-700">{plan.regions}</dd></div>}{plan.reset&&<div><dt class="text-slate-400">流量重置</dt><dd class="mt-1 text-slate-700">{plan.reset}</dd></div>}</dl>}</article>)}</div></section>}
    <section class="mb-8" aria-labelledby="public-capabilities-heading"><div class="mb-5"><h2 id="public-capabilities-heading" class="text-2xl font-extrabold text-slate-900">线路、AI 与流媒体</h2><p class="mt-2 text-xs text-slate-500">资料状态：公开资料整理</p><p class="mt-1 text-xs text-slate-500">资料更新：<time datetime={airport.lastVerified}>{airport.lastVerified}</time></p></div><div class="grid grid-cols-1 md:grid-cols-3 gap-4"><article class="rounded-2xl border border-slate-200 bg-white p-5"><h3 class="text-sm font-bold text-slate-900">线路</h3><p class="mt-3 font-semibold text-blue-700">{airport.capabilities.line.display}</p>{airport.capabilities.line.protocols.length>0&&<p class="mt-2 text-xs text-slate-500">协议：{airport.capabilities.line.protocols.join(' / ')}</p>}{airport.serviceDetails?.line&&<p class="mt-3 text-xs leading-relaxed text-slate-600">{airport.serviceDetails.line}</p>}</article>{aiServices.length>0&&<article class="rounded-2xl border border-slate-200 bg-white p-5"><h3 class="text-sm font-bold text-slate-900">AI 支持</h3><div class="mt-3 flex flex-wrap gap-2">{aiServices.map(service=><span class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700">{service}</span>)}</div>{airport.serviceDetails?.ai&&<p class="mt-3 text-xs leading-relaxed text-slate-600">{airport.serviceDetails.ai}</p>}</article>}{streamingServices.length>0&&<article class="rounded-2xl border border-slate-200 bg-white p-5"><h3 class="text-sm font-bold text-slate-900">流媒体支持</h3><div class="mt-3 flex flex-wrap gap-2">{streamingServices.map(service=><span class="rounded-full bg-blue-50 px-3 py-1.5 text-xs font-semibold text-blue-700">{service}</span>)}</div>{airport.serviceDetails?.streaming&&<p class="mt-3 text-xs leading-relaxed text-slate-600">{airport.serviceDetails.streaming}</p>}</article>}</div><p class="mt-4 text-xs leading-relaxed text-slate-500">可用性可能随节点、出口 IP 与平台策略变化，请以实际使用情况为准。</p></section>
    {testRows.length>0&&<section class="mb-8" aria-labelledby="capabilities-heading"><h2 id="capabilities-heading" class="text-2xl font-extrabold text-slate-900 mb-5">实测数据</h2><div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3">{testRows.map(item=><article class="min-w-0 rounded-xl border border-slate-200 bg-white p-4"><h3 class="text-xs font-semibold text-slate-500">{item.label}</h3><p class="mt-2 break-words font-bold text-slate-900">{item.value}</p></article>)}</div><p class="mt-3 text-xs text-slate-500">实测日期：<time datetime={airport.lastVerified}>{airport.lastVerified}</time></p></section>}
    <section class="rounded-2xl border border-slate-200 bg-slate-50 p-6 mb-8"><h2 class="text-lg font-bold text-slate-900">使用提示</h2><p class="mt-2 text-sm leading-relaxed text-slate-600">建议先选择短周期套餐，在自己的设备和网络环境中验证稳定性。综合推荐评分并非测速结果；延迟、速度、线路和解锁能力仍需按地区、运营商与时段进一步验证。</p><p class="mt-3 text-xs text-slate-500">数据更新时间：<time datetime={airport.lastVerified}>{airport.lastVerified}</time></p></section>
    <section aria-labelledby="related-heading"><h2 id="related-heading" class="text-2xl font-extrabold text-slate-900 mb-5">相关文章</h2>{related.length?<div class="grid grid-cols-1 md:grid-cols-3 gap-5">{related.map(post=><ArticleCard post={post}/>)}</div>:<div class="rounded-2xl border border-slate-200 bg-white p-8 text-center text-sm text-slate-500">暂无与该机场直接相关的文章。</div>}</section>
  </div>
</Layout>


